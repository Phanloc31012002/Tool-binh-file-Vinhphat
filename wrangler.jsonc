{
  "name": "dancard-update",
  "account_id": "38fcd0d6c64f425cb8fc9099f6d55d7b",
  "main": "cloudflare-worker/src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  // Gói cập nhật (ZIP) nằm trong tài nguyên tĩnh của Worker; Worker luôn chạy trước để kiểm tra mã chung.
  "assets": {
    "directory": "cloudflare-worker/generated/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
